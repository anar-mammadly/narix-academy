DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
JWT_SECRET="your-secret-key-minimum-32-characters-long!!"

# Cloudflare R2 (S3-compatible object storage) — used for image and video uploads.
# Get these from the Cloudflare dashboard → R2 → create a bucket, then
# R2 → Manage API Tokens → create a token with "Object Read & Write" permission.
R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_BUCKET_NAME="narix-academy-uploads"
# Public URL for the bucket — either the R2.dev public bucket URL, or a custom
# domain you've connected to the bucket (R2 → bucket → Settings → Public Access).
R2_PUBLIC_URL="https://pub-xxxxxxxx.r2.dev"

# Optional: max video upload size in MB (default 500)
MAX_VIDEO_SIZE_MB=500
